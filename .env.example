# Voice Latency Lab — configuration
# Copy to .env and edit. Every value below is also a plain environment variable;
# the defaults in code match a single-host, loopback deployment.

# -----------------------------------------------------------------------------
# Response backend (required)
#   qwen    hosted OpenAI-compatible chat completions endpoint (needs an API key)
#   gemma4  self-hosted vLLM that accepts audio natively (recommended)
# -----------------------------------------------------------------------------
VOICE_LLM_BACKEND=gemma4

# Used when VOICE_LLM_BACKEND=gemma4. The model must accept audio parts in the
# message content, because the lab sends speech to it directly.
GEMMA4_URL=http://host.docker.internal:18021/v1/chat/completions
GEMMA4_MODEL=gemma4-12b

# Used when VOICE_LLM_BACKEND=qwen. The key file is read at startup and only
# matters in qwen mode; a missing file is a warning, not a crash.
QWEN_URL=http://host.docker.internal:18020/v1/chat/completions
QWEN_MODEL=qwen3.8-27b
QWEN_API_KEY_FILE=/secrets/qwen_api_key.txt

# -----------------------------------------------------------------------------
# Speech to text (required)
# POST raw 16 kHz mono s16le -> {"text": "..."}
# -----------------------------------------------------------------------------
PARAKEET_URL=http://parakeet:3048/transcribe
PARAKEET_MODEL=parakeet-tdt-0.6b-v3
# Set to cpu to run the bundled sidecar without an NVIDIA GPU.
PARAKEET_DEVICE=cuda

# -----------------------------------------------------------------------------
# Text to speech (required)
# Needs /generate and /generate-stable (SSE of base64 PCM16) plus
# /v1/audio/voices for persona voice registration.
# -----------------------------------------------------------------------------
VOXCPM_URL=http://host.docker.internal:3042/generate
VOXCPM_STABLE_URL=http://host.docker.internal:3042/generate-stable
VOXCPM_VOICES_URL=http://host.docker.internal:3042/v1/audio/voices
VOXCPM_SAMPLE_RATE=48000
# 1 = shorter replies + the stable TTS endpoint (demo-safe). 0 = full replies.
STABLE_DEMO_MODE=1

# -----------------------------------------------------------------------------
# Optional shadow features — each fails soft if the endpoint is unreachable
# -----------------------------------------------------------------------------
EMOTION_URL=http://host.docker.internal:3043/analyze
SENSEVOICE_URL=http://host.docker.internal:3047/analyze
KEV_URL=http://host.docker.internal:3046/v1/systemone
VISION_URL=http://host.docker.internal:3045/v1/chat/completions

# -----------------------------------------------------------------------------
# Paths inside the container
# -----------------------------------------------------------------------------
NOMO_REPO_PATH=/nomo-pvad
NOMO_PROFILE_PATH=/profiles/pali.npy
PERSONA_DIR=/profiles/personas
# Built-in personas: id -> prompt + optional TTS delivery description. The real
# file is authored content and stays out of git; see personas.builtin.example.json
# for the format. Read once at startup, so restart after editing.
BUILTIN_PERSONA_FILE=/profiles/personas.builtin.json

# Host port the lab is published on.
VOICE_LAB_PORT=8090
